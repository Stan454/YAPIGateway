{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/post",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "ypost",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/post",
      "UpstreamHttpMethod": [ "Get", "Post" ]
    },
    {
      "DownstreamPathTemplate": "/api/post/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "ypost",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/post/{id}",
      "UpstreamHttpMethod": [ "Get" ]
    },
    {
      "DownstreamPathTemplate": "/api/interaction/like",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "ypost",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/interaction/like",
      "UpstreamHttpMethod": [ "Post" ]
    },
    {
      "DownstreamPathTemplate": "/api/Follow/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "yfollow",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/followings/{id}",
      "UpstreamHttpMethod": [ "Get", "Delete" ]
    },
    {
      "DownstreamPathTemplate": "/api/Follow",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "yfollow",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/followings/{id}",
      "UpstreamHttpMethod": [ "Post" ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5000"
  }
}
